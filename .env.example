# Copia este archivo como .env en la carpeta desde la que ejecutas la aplicación.
# Usa formato KEY=value, sin comillas ni export (Spring lo lee como properties).
# Sustituye la URI por la de tu clúster; codifica los caracteres especiales de las credenciales.
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@HOST.mongodb.net/?retryWrites=true&w=majority
